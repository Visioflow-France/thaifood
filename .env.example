# ------------------------------------------------------------------
#  Configuration du dashboard admin (OPTIONNEL)
#  Ces valeurs ont des valeurs par défaut, ce fichier n'est pas requis.
#  Pour changer les identifiants, copiez ce fichier en ".env.local"
#  et modifiez les valeurs ci-dessous. Relancez ensuite le serveur.
# ------------------------------------------------------------------

# Identifiant de connexion admin
ADMIN_USERNAME=adminthaifood

# Mot de passe de connexion admin
ADMIN_PASSWORD=meilleurthai77

# Secret utilisé pour signer la session (changez-le en production)
SESSION_SECRET=thai-food-77-local-session-secret-change-me

# ------------------------------------------------------------------
#  FIREBASE — Firestore (données) + Storage (photos)
#  Obligatoire en production (Vercel = serverless = pas de disque persistant).
#  Source de la clé : Paramètres du projet → Comptes de service → SDK Admin
#                     Firebase → Générer une nouvelle clé privée (.json)
#  Voir le README, section « Firebase ».
# ------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Collez ici la valeur "private_key" du .json, en gardant les \n, entre guillemets :
FIREBASE_PRIVATE_KEY=
# (Optionnel) Nom du bucket Storage si différent de <projectId>.appspot.com :
#FIREBASE_STORAGE_BUCKET=

# (Optionnel, plus tard — temps réel côté navigateur) Config de l'app web :
#NEXT_PUBLIC_FIREBASE_API_KEY=
#NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
#NEXT_PUBLIC_FIREBASE_PROJECT_ID=
#NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
#  PAIEMENT EN LIGNE — STRIPE CONNECT (OPTIONNEL)
#  Sans ces clés, le site reste en mode « paiement sur place » (rien ne casse).
#  Modèle : Stripe Connect (compte Standard). La clé ci-dessous est celle du compte
#  PLATEFORME (le vôtre, avec Stripe Connect activé). Le restaurateur, lui,
#  connecte son propre compte depuis le dashboard (onglet « Paiement »).
#  Voir le README, section « Paiement en ligne (Stripe) ».
# ------------------------------------------------------------------

# Clé secrète du compte plateforme (sk_test_… en test, sk_live_… en production)
STRIPE_SECRET_KEY=

# Clé publique (pk_test_… en test, pk_live_… en production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret du webhook Stripe (whsec_…). En local, fourni par `stripe listen`.
# En production, créé dans le dashboard Stripe (endpoint /api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=

# Commission plateforme (%) prélevée sur chaque commande. Réglée par la
# PLATEFORME (vous), jamais par le restaurateur (n'apparaît pas dans le dashboard).
# 0 = aucune commission ; ex. 5 = 5 %.
PLATFORM_COMMISSION_PERCENT=0

# ------------------------------------------------------------------
#  SEO — domaine canonique & vérification Google Search Console
#  Indispensable en production pour des URLs (canonical, OG, sitemap)
#  absolues et correctes.
# ------------------------------------------------------------------

# URL canonique du site, SANS slash final (ex. https://thaifood.fr).
NEXT_PUBLIC_SITE_URL=https://thaifood.fr

# Code de vérification Google Search Console (le contenu de content="…").
# À coller une fois le domaine ajouté dans Search Console. Laisser vide sinon.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

