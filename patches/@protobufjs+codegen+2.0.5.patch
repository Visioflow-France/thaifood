+// ===========================================================================
+//  PATCH WORKERS — génération du constructeur de message SANS eval.
+//  Motif généré par Type.generateConstructor de protobufjs :
+//    function Name(p) {
+//      this.a = [];
+//      this.b = {};
+//      if(p)for(var ks=Object.keys(p),i=0;i<ks.length;++i)
+//        if(p[ks[i]]!=null&&ks[i]!=="__proto__")
+//          this[ks[i]]=p[ks[i]];
+//    }
+//  On reconnaît ce motif et on retourne une closure équivalente. Tout autre
+//  motif échoue immédiatement avec un message clair (pas d'échec silencieux).
+// ===========================================================================
+
+function workerSafeCompile(source, functionParams, scope) {
+    var ctorMatch = source.match(/^function\s+([\w$]*)\s*\(\s*(\w*)\s*\)\s*\{/);
+    if (
+        ctorMatch &&
+        /if\s*\(\s*\w+\s*\)\s*for\s*\(/.test(source) &&
+        /this\[ks\[i\]\]\s*=/.test(source)
+    ) {
+        // Initialisations "this.x = [];" / "this.x = {};" avant le if(p).
+        var initRe = /this\.([\w$]+)\s*=\s*(\[\]|\{\})\s*;/g;
+        var inits = [];
+        var mm;
+        while ((mm = initRe.exec(source)) !== null) {
+            inits.push({ name: mm[1], isArray: mm[2] === "[]" });
+        }
+        // Closure équivalente, sans eval.
+        var Ctor = function (p) {
+            for (var j = 0; j < inits.length; j++) {
+                this[inits[j].name] = inits[j].isArray ? [] : {};
+            }
+            if (p)
+                for (var ks = Object.keys(p), i = 0; i < ks.length; ++i) {
+                    if (p[ks[i]] != null && ks[i] !== "__proto__")
+                        this[ks[i]] = p[ks[i]];
+                }
+        };
+        return Ctor;
+    }
+    throw new Error(
+        "protobufjs codegen: motif non supporté sans eval -> " + source.slice(0, 120)
+    );
+}
