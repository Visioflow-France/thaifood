rules_version = '2';

// ============================================================================
//  RÈGLES FIRESTORE — verrouillage TOTAL côté client.
// ----------------------------------------------------------------------------
//  TOUT l'accès aux données se fait côté SERVEUR via le SDK Firebase Admin
//  (firebase-admin), qui contourne ces règles. Le navigateur n'accède JAMAIS
//  directement à Firestore (le menu vient de /api/menu, les commandes du flux
//  SSE /api/admin/orders/stream qui utilisent onSnapshot côté serveur).
//
//  → On refuse donc tout accès client. Cela protège les données clients (PII
//    des commandes) même si quelqu'un tentait d'attaquer directement Firestore.
//
//  À déployer :  firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
